ninja_required_version = 1.3
cxx = c++

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -fPIC -I/usr/local/lib/python3.12/dist-packages/torch/include -I/usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/usr/include/python3.12 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=ext -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc







build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/cpu/grid_subsampling/grid_subsampling.o: compile /workspace/src/geotransformer/extensions/cpu/grid_subsampling/grid_subsampling.cpp
build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/cpu/grid_subsampling/grid_subsampling_cpu.o: compile /workspace/src/geotransformer/extensions/cpu/grid_subsampling/grid_subsampling_cpu.cpp
build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/cpu/radius_neighbors/radius_neighbors.o: compile /workspace/src/geotransformer/extensions/cpu/radius_neighbors/radius_neighbors.cpp
build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/cpu/radius_neighbors/radius_neighbors_cpu.o: compile /workspace/src/geotransformer/extensions/cpu/radius_neighbors/radius_neighbors_cpu.cpp
build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/extra/cloud/cloud.o: compile /workspace/src/geotransformer/extensions/extra/cloud/cloud.cpp
build /workspace/src/build/temp.linux-x86_64-cpython-312/geotransformer/extensions/pybind.o: compile /workspace/src/geotransformer/extensions/pybind.cpp








